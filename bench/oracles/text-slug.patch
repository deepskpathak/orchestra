diff --git a/src/text.js b/src/text.js
--- a/src/text.js
+++ b/src/text.js
@@ -1,3 +1,10 @@
 export function capitalize(s) {
   return s.charAt(0).toUpperCase() + s.slice(1);
 }
+
+export function slugify(s) {
+  return s
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
